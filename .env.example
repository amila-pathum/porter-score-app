# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL (docker compose)
POSTGRES_PASSWORD=porter
POSTGRES_PORT=5433

# API
# HMAC key for access tokens: at least 32 random characters. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-at-least-32-chars
# Public URL of the web app (used in password-reset links)
PUBLIC_URL=http://localhost:8080
# true when served over HTTPS (production)
SECURE_COOKIES=false
# Seed the demo account (demo@porter.local / PorterDemo1). Keep false in production.
SEED_DEMO_DATA=true

# Web
WEB_PORT=8080
